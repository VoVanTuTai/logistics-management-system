<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="nexus-dt-commerce-simple" name="DT-Commerce Nexus Simple Flow">
    <mxGraphModel dx="1377" dy="947" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#111827;" value="Sơ đồ giao tiếp giữa Emall và Nexus Express&lt;br&gt;&lt;font style=&quot;font-size: 15px; font-weight: 400; color: rgb(75, 85, 99);&quot;&gt;Luồng đặt hàng, giao nhận và cập nhật trạng thái đơn hàng&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1320" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="dtLane" parent="1" style="swimlane;html=1;startSize=44;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1E3A8A;horizontal=1;" value="Emall" vertex="1">
          <mxGeometry height="650" width="420" x="70" y="130" as="geometry" />
        </mxCell>
        <mxCell id="nexusLane" parent="1" style="swimlane;html=1;startSize=44;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#111827;horizontal=1;" value="Nexus Express" vertex="1">
          <mxGeometry height="650" width="770" x="560" y="130" as="geometry" />
        </mxCell>
        <mxCell id="deliveryFlow" parent="nexusLane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#064E3B;" value="5. Nexus xử lý giao nhận&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Điều phối courier, scan lấy hàng, nhập kho/xuất kho, đóng bao, giao hàng, POD/OTP, COD, hoàn hàng nếu có&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="340" x="400" y="295" as="geometry" />
        </mxCell>
        <mxCell id="webhook" parent="nexusLane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#881337;" value="Webhook cập nhật trạng thái về DT-Commerce&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;shipment.status_changed, shipment.delivered, shipment.delivery_failed, shipment.returned, shipment.cancelled&lt;br&gt;Có chữ ký HMAC và retry khi gửi lỗi&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="246" y="487" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="nexusLane" source="deliveryFlow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E11D48;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#881337;" target="webhook" value="trạng thái thay đổi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="buyer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#1E3A8A;" value="1. Người mua đặt hàng&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Chọn sản phẩm, địa chỉ nhận hàng và COD nếu có&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="310" x="120" y="210" as="geometry" />
        </mxCell>
        <mxCell id="dtOrder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#1E3A8A;" value="2. Emall gửi đơn sang Nexus&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;POST /merchant/integrations/orders&lt;br&gt;Gửi thông tin shop, người gửi, người nhận, hàng hóa, COD&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="310" x="120" y="360" as="geometry" />
        </mxCell>
        <mxCell id="dtStatus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#1E3A8A;" value="6. Emall nhận trạng thái&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Cập nhật AWB, tracking, đang giao, giao thành công, giao thất bại, hoàn hàng&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="120" y="590" as="geometry" />
        </mxCell>
        <mxCell id="gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#7C2D12;" value="3. Gateway kiểm tra và tiếp nhận đơn&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Kiểm tra API key, chữ ký HMAC, timestamp, nonce&lt;br&gt;Idempotency-Key giúp gửi lại không tạo trùng vận đơn&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="300" x="620" y="200" as="geometry" />
        </mxCell>
        <mxCell id="createShipment" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;arcSize=8;fontSize=14;fontStyle=1;fontColor=#14532D;" value="4. Nexus tạo vận đơn và yêu cầu lấy hàng&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;shipment-service tạo mã vận đơn&lt;br&gt;masterdata-service xác định hub lấy/giao&lt;br&gt;pickup-service tạo yêu cầu lấy hàng nếu cần&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="300" x="980" y="200" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;arcSize=8;fontSize=13;fontColor=#374151;align=left;spacing=12;" value="Ghi chú đơn giản:&lt;br&gt;• DT-Commerce chỉ cần gửi đơn vào Gateway của Nexus, không cần biết các service nội bộ.&lt;br&gt;• Nexus trả về shipmentCode, trackingUrl, labelUrl và pickup status.&lt;br&gt;• Khi trạng thái vận đơn thay đổi, Nexus chủ động gửi webhook ngược lại cho DT-Commerce.&lt;br&gt;• Luồng bảo mật dùng API key, HMAC, timestamp, nonce và idempotency để tránh giả mạo hoặc tạo trùng đơn." vertex="1">
          <mxGeometry height="90" width="1240" x="80" y="825" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="buyer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#1E3A8A;" target="dtOrder" value="tạo đơn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="dtOrder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1E3A8A;" target="gateway" value="API tạo vận đơn">
          <mxGeometry relative="1" x="-0.0187" y="-27" as="geometry">
