@startuml
!theme plain
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 140
skinparam wrapWidth 200
skinparam BoxPadding 8
autonumber "<b>[00]</b>"


box "Boundary Layer (Giao Diện & Gateway)" #FFFFFF
actor "Bưu tá / Shipper\n(Courier User)" as Courier
boundary "ProfileScreen / Modal\n(apps/courier-mobile)" as UI
boundary "Gateway BFF (:3000)\n(CourierController)" as Gateway
end box

box "Control Layer (Điều Khiển & Xác Thực)" #FFFFFF
control "ChangePasswordMutation\n(React Query hook)" as Mutation
control "AuthController\n(:3010 auth-service)" as AuthCtrl
control "AuthService\n(application service)" as AuthSvc
control "HashService\n(bcrypt digest)" as HashSvc
end box

box "Entity Layer (Dữ Liệu PostgreSQL auth_db)" #FFFFFF
entity "PostgreSQL (auth_db)\n[user_accounts Table]" as AuthDB
end box

' GIAI ĐOẠN 1: MỞ MODAL VÀ NHẬP THÔNG TIN MẬT KHẨU
Courier -> UI: Mở tab "Cá nhân" (ProfileScreen)\nvà nhấn "Đổi mật khẩu tài khoản"
activate UI

UI -> UI: Render Modal đổi mật khẩu (Mật khẩu cũ, Mật khẩu mới, Xác nhận)

Courier -> UI: Nhập mật khẩu cũ, mật khẩu mới, xác nhận\nvà nhấn "Lưu thay đổi" (handleSavePassword)

alt Lỗi tiền kiểm tra tại giao diện điện thoại
    alt Bỏ trống trường thông tin
        UI -> UI: Alert.alert("Thiếu thông tin", "Vui lòng nhập đầy đủ tất cả các trường.")
    else Mật khẩu mới không trùng khớp
        UI -> UI: Alert.alert("Mật khẩu không khớp", "Mật khẩu mới và mật khẩu xác nhận không trùng khớp.")
    else Mật khẩu mới chưa đạt độ phức tạp (<8 ký tự, thiếu chữ hoặc số)
        UI -> UI: Alert.alert("Mật khẩu chưa hợp lệ", "Mật khẩu mới phải dài ít nhất 8 ký tự và bao gồm cả chữ cái và chữ số.")
    end
else Dữ liệu hợp lệ: Gửi yêu cầu đổi mật khẩu
    UI -> Mutation: mutateAsync({ currentPassword, newPassword })
    activate Mutation

    ' GIAI ĐOẠN 2: GỬI REQUEST QUA GATEWAY BFF
    Mutation -> Gateway: POST /courier/auth/auth/change-password\n(Bearer accessToken, Body: { currentPassword, newPassword })
    activate Gateway

    note over Gateway: GatewayAuthGuard & RoleGuard (Role: 'COURIER_APP') -> proxy :3010

    Gateway -> AuthCtrl: POST /auth/change-password\n(Body: ChangePasswordInputDto, User: session.user)
    activate AuthCtrl

    AuthCtrl -> AuthSvc: changePassword(userId, input)
    activate AuthSvc

    ' GIAI ĐOẠN 3: XÁC THỰC MẬT KHẨU CŨ & BĂM MẬT KHẨU MỚI
    AuthSvc -> AuthDB: SELECT * FROM user_accounts WHERE id = $1
    activate AuthDB
    AuthDB --> AuthSvc: Bản ghi tài khoản (UserAccount)
    deactivate AuthDB

    AuthSvc -> HashSvc: compare(currentPassword, account.passwordHash)
    activate HashSvc
    HashSvc --> AuthSvc: Kết quả so khớp mật khẩu cũ
    deactivate HashSvc

    alt Mật khẩu hiện tại không chính xác
        AuthSvc --> AuthCtrl: throw BadRequestException("Mật khẩu hiện tại không chính xác.")
        AuthCtrl --> Gateway: 400 Bad Request
        Gateway --> Mutation: 400 Bad Request
        Mutation --> UI: throw Error("Mật khẩu hiện tại không chính xác.")
        UI -> UI: Alert.alert("Lỗi đổi mật khẩu", "Mật khẩu hiện tại không chính xác.")
    else Mật khẩu hiện tại khớp: Băm và cập nhật mật khẩu mới
        AuthSvc -> HashSvc: hash(newPassword, 10)
        activate HashSvc
        HashSvc --> AuthSvc: passwordHash mới
        deactivate HashSvc

        ' GIAI ĐOẠN 4: CẬP NHẬT DATABASE
        AuthSvc -> AuthDB: UPDATE user_accounts SET password_hash = $1, updated_at = NOW() WHERE id = $2
        activate AuthDB
        AuthDB --> AuthSvc: Cập nhật thành công
        deactivate AuthDB

        AuthSvc --> AuthCtrl: ChangePasswordResultDto { success: true }
        deactivate AuthSvc

        AuthCtrl --> Gateway: 200 OK: ChangePasswordResultDto
        deactivate AuthCtrl

        Gateway --> Mutation: 200 OK
        deactivate Gateway

        Mutation --> UI: Thành công
        deactivate Mutation

        ' GIAI ĐOẠN 5: ĐÓNG MODAL VÀ THÔNG BÁO CHO BƯU TÁ
        UI -> UI: 1. Reset các trường nhập liệu\n2. Đóng Modal đổi mật khẩu (setPasswordModalVisible(false))
        UI -> UI: Alert.alert("Thành công", "Mật khẩu đã được thay đổi thành công.")
    end
end

deactivate UI
@enduml

