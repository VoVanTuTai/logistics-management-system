@startuml
!theme plain
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 140
skinparam wrapWidth 200
skinparam BoxPadding 8
autonumber "<b>[00]</b>"

box "Boundary Layer (Giao Diện & Cổng Kết Nối)" #FFFFFF
actor "Nhân viên vận hành\n(Ops Staff User)" as Ops
boundary "ChangePasswordModal\n(apps/ops-web)" as UI
boundary "Gateway BFF (:3000)\n(OpsAuthController)" as Gateway
end box

box "Control Layer (Điều Khiển & Mã Hóa Mật Khẩu)" #FFFFFF
control "AuthController\n(:3010 auth-service)" as AuthCtrl
control "AuthService\n(application service)" as AuthSvc
control "HashService\n(bcrypt digest)" as HashSvc
end box

box "Entity Layer (Lưu Trữ & Cơ Sở Dữ Liệu)" #FFFFFF
entity "PostgreSQL (auth_db)\n[user_accounts & auth_sessions]" as AuthDB
end box

' GIAI ĐOẠN 1: NHẬP LIỆU VÀ KIỂM TRA ĐẦU VÀO FORM ĐỔI MẬT KHẨU
Ops -> UI: Mở hộp thoại Đổi mật khẩu,\nnhập Mật khẩu hiện tại, Mật khẩu mới & Xác nhận mật khẩu mới
activate UI

Ops -> UI: Bấm nút "Lưu thay đổi" (handleChangePassword)

alt Lỗi dữ liệu đầu vào (Validation Error)
    UI -> UI: Kiểm tra: !currentPassword || !newPassword || newPassword !== confirmPassword || newPassword.length < 8\nHiển thị cảnh báo lỗi trực tiếp trên giao diện
else Dữ liệu hợp lệ: Gửi yêu cầu đổi mật khẩu
    UI -> Gateway: POST /ops/auth/auth/change-password\n(Headers: Bearer accessToken, Body: { accessToken, currentPassword, newPassword })
    activate Gateway

    ' GIAI ĐOẠN 2: XÁC THỰC MẬT KHẨU CŨ & BĂM MẬT KHẨU MỚI
    Gateway -> AuthCtrl: POST /auth/change-password (ChangePasswordInput)
    activate AuthCtrl

    AuthCtrl -> AuthSvc: changePassword(input)
    activate AuthSvc

    AuthSvc -> AuthDB: SELECT * FROM auth_sessions WHERE access_token_hash = $hash AND expires_at > NOW()
    activate AuthDB
    AuthDB --> AuthSvc: Trả về phiên hợp lệ (userId)
    deactivate AuthDB

    AuthSvc -> AuthDB: SELECT * FROM user_accounts WHERE id = $userId AND status = 'ACTIVE'
    activate AuthDB
    AuthDB --> AuthSvc: Trả về thông tin tài khoản nhân viên (UserAccount)
    deactivate AuthDB

    AuthSvc -> HashSvc: verify(currentPassword, user.passwordHash)
    activate HashSvc
    HashSvc --> AuthSvc: Kết quả đối soát mật khẩu cũ
    deactivate HashSvc

    alt Mật khẩu hiện tại không đúng
        AuthSvc --> AuthCtrl: 401 UnauthorizedException ("Current password is incorrect.")
        AuthCtrl --> Gateway: 401 Unauthorized
        Gateway --> UI: 401 Unauthorized
        UI -> UI: Render lỗi: "Mật khẩu hiện tại không chính xác. Vui lòng kiểm tra lại."
    else Mật khẩu hiện tại khớp: Cập nhật mật khẩu mới
        AuthSvc -> HashSvc: digest(newPassword)
        activate HashSvc
        HashSvc --> AuthSvc: passwordHash mới (chuỗi băm bcrypt an toàn)
        deactivate HashSvc

        AuthSvc -> AuthDB: UPDATE user_accounts SET password_hash = $newHash, updated_at = NOW() WHERE id = $userId
        activate AuthDB
        AuthDB --> AuthSvc: Cập nhật bản ghi thành công
        deactivate AuthDB

        AuthSvc --> AuthCtrl: ChangePasswordResult { changed: true, userId }
        deactivate AuthSvc

        AuthCtrl --> Gateway: 200 OK (ChangePasswordResult)
        deactivate AuthCtrl

        Gateway --> UI: 200 OK { changed: true }
        deactivate Gateway

        ' GIAI ĐOẠN 3: PHẢN HỒI GIAO DIỆN THÀNH CÔNG VÀ ĐÓNG MODAL
        UI -> UI: Hiển thị Toast thông báo: "Đổi mật khẩu thành công!"
        UI -> UI: Tự động đóng modal (onClose)
    end
end

deactivate UI
@enduml
