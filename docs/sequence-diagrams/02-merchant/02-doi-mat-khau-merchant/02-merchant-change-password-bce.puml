@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 140
skinparam wrapWidth 200
skinparam BoxPadding 8
autonumber "<b>[00]</b>"


box "Boundary Layer (Giao Diện & Gateway)" #F8FAFC
actor "Chủ shop / Người gửi\n(Merchant User)" as Merchant
boundary "MerchantAccountView\n(apps/merchant-web UI)" as UI
boundary "Gateway BFF (:3000)\n(MerchantController)" as Gateway
end box

box "Control Layer (Điều Khiển & Xác Thực Nghiệp Vụ)" #FFFFFF
control "AuthController\n(:3010 auth-service)" as AuthCtrl
control "AuthService\n(application service)" as AuthSvc
control "HashService\n(security digest)" as HashSvc
end box

box "Entity Layer (Dữ Liệu PostgreSQL auth_db)" #F8FAFC
entity "PostgreSQL (auth_db)\n[auth_sessions Table]" as SessionDB
entity "PostgreSQL (auth_db)\n[user_accounts Table]" as UserDB
end box

' BƯỚC 1: KHỞI TẠO ĐỔI MẬT KHẨU TẠI GIAO DIỆN
note over Merchant, UI
  Người dùng chọn mục "Tài khoản" (activeView = 'account')
  tại MerchantSidebar -> mở MerchantAccountView
end note

Merchant -> UI: Điền form "Đổi mật khẩu":\n- Mật khẩu hiện tại (passwordOld)\n- Mật khẩu mới (passwordNew)\n- Xác nhận mật khẩu mới (passwordConfirm)\n& bấm nút "Đổi mật khẩu"
activate UI

' BƯỚC 2: VALIDATION ĐẦU VÀO TẠI CLIENT (changeAccountPassword in main.tsx)
alt Lỗi Form 1: Thiếu trường dữ liệu (!passwordOld || !passwordNew || !passwordConfirm)
    UI -> UI: setPasswordMessage('Cần nhập đầy đủ thông tin')
    UI -> UI: Hiển thị cảnh báo: "Vui lòng nhập đầy đủ thông tin mật khẩu"

else Lỗi Form 2: Mật khẩu xác nhận không khớp (passwordNew !== passwordConfirm)
    UI -> UI: setPasswordMessage('Mật khẩu xác nhận không khớp')
    UI -> UI: Hiển thị cảnh báo: "Mật khẩu xác nhận không trùng khớp"

else Hợp lệ Form: setPasswordSaving(true) & gửi yêu cầu qua Gateway BFF
    UI -> Gateway: POST /merchant/auth/auth/change-password\nHeaders: Authorization: Bearer <accessToken>\nBody: { accessToken, currentPassword, newPassword }
    activate Gateway

    note over Gateway
      - GatewayAuthGuard: Kiểm tra Header Authorization
      - GatewayRoleGuard: Xác thực Bearer token hợp lệ
        qua AuthServiceClient.introspect(token)
        và kiểm tra vai trò 'MERCHANT'
      - ServiceRegistryClient: Phân giải 'auth'
        -> AUTH_SERVICE_URL (:3010)
      - GatewayProxyClient.forward('merchant', ...)
    end note

    alt Lỗi 401: Token hết hạn hoặc không hợp lệ (introspect.active == false)
        Gateway --> UI: 401 Unauthorized\n("Mã truy cập không hợp lệ hoặc đã hết hạn.")
        UI -> UI: setPasswordMessage(error)
        UI -> UI: Hiển thị cảnh báo: "Phiên đăng nhập đã hết hạn, vui lòng đăng nhập lại"

    else Lỗi 403: Sai vai trò (Token không có quyền MERCHANT)
        Gateway --> UI: 403 Forbidden\n("Tài khoản không thuộc nhóm quyền Chủ shop (Merchant).")
        UI -> UI: setPasswordMessage(error)
        UI -> UI: Hiển thị cảnh báo: "Tài khoản không có quyền thực hiện thao tác này"

    else Hợp lệ Gateway: Chuyển tiếp tới Auth Service
        Gateway -> AuthCtrl: POST /auth/change-password\n(Body: ChangePasswordInput)
        activate AuthCtrl

        AuthCtrl -> AuthSvc: changePassword(input: ChangePasswordInput)
        activate AuthSvc

        ' BƯỚC 3: KIỂM TRA PHIÊN HOẠT ĐỘNG (GET ACTIVE SESSION)
        AuthSvc -> SessionDB: authSessionRepository.findActiveByAccessTokenHash(\n  hashService.digest(accessToken)\n)
        activate SessionDB
        SessionDB --> AuthSvc: AuthSession record | null
        deactivate SessionDB

        alt Lỗi 401: Phiên không tồn tại hoặc đã hết hạn
            AuthSvc --> AuthCtrl: throw UnauthorizedException(\n  "Mã truy cập không hợp lệ hoặc đã hết hạn.")
            AuthCtrl --> Gateway: 401 Unauthorized
            Gateway --> UI: 401 Unauthorized
            UI -> UI: Hiển thị thông báo: "Phiên làm việc đã hết hạn"

        else Phiên hợp lệ: Gia hạn thời gian trượt (Sliding Touch)
            AuthSvc -> SessionDB: authSessionRepository.touch(session.id, slidingExpiresAt)
            activate SessionDB
            SessionDB --> AuthSvc: Touched session
            deactivate SessionDB

            ' BƯỚC 4: KIỂM TRA TÀI KHOẢN NGƯỜI DÙNG (GET ACTIVE USER)
            AuthSvc -> UserDB: userAccountRepository.findById(session.userId)
            activate UserDB
            UserDB --> AuthSvc: UserAccount record (status == 'ACTIVE')
            deactivate UserDB

            ' BƯỚC 5: KIỂM SOÁT POLICY ĐỘ PHỨC TẠP MẬT KHẨU MỚI (normalizePassword)
            alt Lỗi 400: Mật khẩu mới không đạt chuẩn policy (< 8 ký tự, thiếu chữ hoặc số)
                AuthSvc --> AuthCtrl: throw BadRequestException(\n  "Mật khẩu mới phải có tối thiểu 8 ký tự,\n  bao gồm cả chữ cái và chữ số.")
                AuthCtrl --> Gateway: 400 Bad Request
                Gateway --> UI: 400 Bad Request
                UI -> UI: setPasswordMessage(error)
                UI -> UI: Hiển thị cảnh báo: "Mật khẩu mới phải có tối thiểu 8 ký tự, bao gồm cả chữ và số"

            else Mật khẩu mới đạt chuẩn: Đối soát mật khẩu cũ
                AuthSvc -> HashSvc: verify(currentPassword, user.passwordHash)
                activate HashSvc
                HashSvc --> AuthSvc: boolean (true / false)
                deactivate HashSvc

                alt Lỗi 401: Mật khẩu cũ không chính xác
                    AuthSvc --> AuthCtrl: throw UnauthorizedException(\n  "Mật khẩu hiện tại không chính xác.")
                    AuthCtrl --> Gateway: 401 Unauthorized
                    Gateway --> UI: 401 Unauthorized
                    UI -> UI: setPasswordMessage(error)
                    UI -> UI: Hiển thị cảnh báo đỏ: "Mật khẩu hiện tại không chính xác"

                else Hợp lệ 100%: Băm mật khẩu mới & Cập nhật cơ sở dữ liệu
                    AuthSvc -> HashSvc: digest(newPassword)
                    activate HashSvc
                    HashSvc --> AuthSvc: newPasswordHash (SHA-256 Digest)
                    deactivate HashSvc

                    AuthSvc -> UserDB: userAccountRepository.update(user.id, {\n  passwordHash: newPasswordHash\n})
                    activate UserDB
                    UserDB --> AuthSvc: UserAccount updated
                    deactivate UserDB

                    AuthSvc --> AuthCtrl: ChangePasswordResult { changed: true, userId: user.id }
                    deactivate AuthSvc

                    AuthCtrl --> Gateway: 200 OK (ChangePasswordResult)
                    deactivate AuthCtrl

                    Gateway --> UI: 200 OK ({ changed: true, userId: "..." })
                    deactivate Gateway

                    ' BƯỚC 6: PHẢN HỒI GIAO DIỆN CLIENT
                    UI -> UI: setPasswordMessage('Đã cập nhật mật khẩu thành công.')\nReset fields: setPasswordOld(''),\nsetPasswordNew(''), setPasswordConfirm('')\nsetPasswordSaving(false)
                    UI -> UI: Hiển thị thông báo thành công: "Đã cập nhật mật khẩu thành công."
                    deactivate UI
                end
            end
        end
    end
end

@enduml
