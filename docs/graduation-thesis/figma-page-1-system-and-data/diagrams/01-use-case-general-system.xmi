<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20131001">
  <uml:Model xmi:type="uml:Model" xmi:id="model_nexus_logistics" name="Nexus Logistics Enterprise Platform">
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_guest" name="Khách Vãng Lai (Guest User)">
    </packagedElement>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_customer" name="Khách Hàng Cá Nhân (Customer C-End)">
      <generalization xmi:type="uml:Generalization" xmi:id="gen_cust_guest" general="actor_guest"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_merchant" name="Người Gửi Hàng (Merchant B2B)">
    </packagedElement>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_ops" name="Nhân Viên Vận Hành (Ops Staff)">
      <generalization xmi:type="uml:Generalization" xmi:id="gen_ops_shipper" general="actor_shipper"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_shipper" name="Nhân Viên Giao Hàng (Shipper)">
    </packagedElement>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_admin" name="Quản Trị Viên (System Admin)">
    </packagedElement>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_system" name="Trợ Lý AI &amp; Hệ Thống (Supporting System)">
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_auth" name="Cổng Xác Thực &amp; Bảo Mật Hệ Thống (auth-service • gateway-bff)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_auth_01" name="UC-AUTH-01: Đăng nhập hệ thống (Core Auth Hub)">
        <include xmi:type="uml:Include" xmi:id="inc_uc_auth_01_uc_auth_03" addition="uc_auth_03"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_auth_02" name="UC-AUTH-02: Đăng xuất hệ thống">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_auth_02_uc_auth_01" extendedCase="uc_auth_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_auth_03" name="UC-AUTH-03: Quản lý thông tin tài khoản">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_orders" name="Phân Hệ 1: Tiếp Nhận &amp; Quản Lý Đơn Hàng (shipment-service • pickup-service)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_01" name="UC-ORD-01: Tạo đơn gửi bưu phẩm">
        <include xmi:type="uml:Include" xmi:id="inc_uc_ord_01_uc_ord_05" addition="uc_ord_05"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_01a" name="UC-ORD-01a: Tạo đơn hàng Web Portal">
        <generalization xmi:type="uml:Generalization" xmi:id="gen_uc_ord_01a_uc_ord_01" general="uc_ord_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_01b" name="UC-ORD-01b: Tạo đơn gửi hàng lẻ">
        <generalization xmi:type="uml:Generalization" xmi:id="gen_uc_ord_01b_uc_ord_01" general="uc_ord_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_01c" name="UC-ORD-01c: Tạo đơn khách vãng lai">
        <generalization xmi:type="uml:Generalization" xmi:id="gen_uc_ord_01c_uc_ord_01" general="uc_ord_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_02" name="UC-ORD-02: Quản lý &amp; Lọc danh sách đơn">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_03" name="UC-ORD-03: Yêu cầu đổi thông tin giao">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_04" name="UC-ORD-04: Hủy đơn hàng chưa lấy">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_05" name="UC-ORD-05: In nhãn phiếu gửi A6/A7">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_06" name="UC-ORD-06: In nhiều vận đơn hàng loạt">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_ord_06_uc_ord_02" extendedCase="uc_ord_02"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_07" name="UC-ORD-07: Gắn tem Hàng Dễ Vỡ [FRAGILE]">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_ord_07_uc_ord_05" extendedCase="uc_ord_05"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_08" name="UC-ORD-08: Quản lý sổ địa chỉ">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ord_09" name="UC-ORD-09: Đặt lịch hẹn lấy hàng Pickup">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_hub" name="Phân Hệ 2: Bưu Cục, Điều Phối &amp; Trung Chuyển (scan • manifest • dispatch)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_01" name="UC-HUB-01: Giám sát Dashboard thời gian thực">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_01a" name="UC-HUB-01a: Tra cứu hành trình đơn nội bộ">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_01b" name="UC-HUB-01b: Tạo đơn hàng tại quầy (Walk-in)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_02" name="UC-HUB-02: Bảng kê manifest &amp; Đóng bao">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_02_uc_hub_03" addition="uc_hub_03"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_02a" name="UC-HUB-02a: Phê duyệt yêu cầu lấy hàng Pickup">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_02a_uc_hub_02b" addition="uc_hub_02b"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_02b" name="UC-HUB-02b: Gán việc shipper (lấy &amp; phát)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_02c" name="UC-HUB-02c: Xác nhận lấy hàng (Scan Pickup)">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_02c_uc_hub_02b" addition="uc_hub_02b"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_03" name="UC-HUB-03: Đóng seal niêm kẹp chì an ninh">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_04" name="UC-HUB-04: Quản lý chuyến xe tải Linehaul">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_04_uc_hub_05" addition="uc_hub_05"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_04_uc_hub_02" addition="uc_hub_02"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_05" name="UC-HUB-05: Cấp tem niêm phong xe tải (XT)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_06" name="UC-HUB-06: Quét xuất kho Outbound">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_06_uc_hub_02" addition="uc_hub_02"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_07" name="UC-HUB-07: Quét nhập kho Inbound">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_07_uc_hub_08" addition="uc_hub_08"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_08" name="UC-HUB-08: Gỡ bao &amp; Kiểm đếm chia chọn">
        <include xmi:type="uml:Include" xmi:id="inc_uc_hub_08_uc_hub_09" addition="uc_hub_09"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_hub_09" name="UC-HUB-09: Quét bàn giao bưu tá (handoff)">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_delivery" name="Phân Hệ 3: Giao Hàng Chặng Cuối &amp; Xử Lý Sự Cố (delivery-service • shipment)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_01" name="UC-DEL-01: Quản lý danh sách nhiệm vụ giao">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_01a" name="UC-DEL-01a: Bản đồ lộ trình giao hàng GPS">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_del_01a_uc_del_01" extendedCase="uc_del_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_02" name="UC-DEL-02: Liên hệ người nhận (ẩn số)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_03" name="UC-DEL-03: Xác thực mã OTP 6 chữ số">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_04" name="UC-DEL-04: Chụp ảnh POD &amp; Chữ ký số">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_05" name="UC-DEL-05: Xác nhận giao thành công">
        <include xmi:type="uml:Include" xmi:id="inc_uc_del_05_uc_del_03" addition="uc_del_03"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_del_05_uc_del_04" addition="uc_del_04"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_06" name="UC-DEL-06: Cập nhật sự cố thất bại NDR">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_del_06_uc_del_05" extendedCase="uc_del_05"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_06a" name="UC-DEL-06a: Hẹn lại ngày phát (Reschedule)">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_del_06a_uc_del_06" extendedCase="uc_del_06"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_07" name="UC-DEL-07: Xử lý sự cố phát thất bại (NDR)">
        <include xmi:type="uml:Include" xmi:id="inc_uc_del_07_uc_del_08" addition="uc_del_08"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_del_08" name="UC-DEL-08: Quản lý &amp; Tạo chuyển hoàn RTS">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_finance" name="Phân Hệ 4: Tài Chính, Thu Hộ COD &amp; Đối Soát (payment-service • reporting)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_01" name="UC-FIN-01: Thu hộ tiền mặt COD">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_02" name="UC-FIN-02: Nộp tiền COD qua VietQR">
        <include xmi:type="uml:Include" xmi:id="inc_uc_fin_02_uc_fin_01" addition="uc_fin_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_03" name="UC-FIN-03: Phê duyệt quyết toán COD thủ công">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_fin_03_uc_fin_04" extendedCase="uc_fin_04"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_04" name="UC-FIN-04: Đối soát giải ngân COD &amp; VietQR">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_05" name="UC-FIN-05: Lịch sử đối soát SePay/VietQR">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_06" name="UC-FIN-06: Khớp nối SePay &amp; Khấu trừ tự động">
        <include xmi:type="uml:Include" xmi:id="inc_uc_fin_06_uc_fin_04" addition="uc_fin_04"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_fin_07" name="UC-FIN-07: Khấu trừ cước hoàn phân tầng">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_fin_07_uc_fin_05" extendedCase="uc_fin_05"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_ai" name="Phân Hệ 5: Trợ Lý AI Logistics RAG &amp; Tra Cứu Hành Trình (chatbot-service • tracking)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_01" name="UC-AI-01: Tra cứu hành trình bưu phẩm">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_01a" name="UC-AI-01a: Tra cứu bưu kiện công khai">
        <generalization xmi:type="uml:Generalization" xmi:id="gen_uc_ai_01a_uc_ai_01" general="uc_ai_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_01b" name="UC-AI-01b: Tra cứu hành trình realtime">
        <generalization xmi:type="uml:Generalization" xmi:id="gen_uc_ai_01b_uc_ai_01" general="uc_ai_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_01c" name="UC-AI-01c: Tra cứu tiến độ (Merchant)">
        <generalization xmi:type="uml:Generalization" xmi:id="gen_uc_ai_01c_uc_ai_01" general="uc_ai_01"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_02" name="UC-AI-02: Ước tính cước phí bưu chính IATA">
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_02_uc_ai_03" addition="uc_ai_03"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_03" name="UC-AI-03: Động cơ cước chuẩn IATA V/6000">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_04" name="UC-AI-04: Trò chuyện cùng trợ lý AI 24/7">
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_04_uc_ai_06" addition="uc_ai_06"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_04_uc_ai_07" addition="uc_ai_07"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_05a" name="UC-AI-05a: Tool: Tra cứu vận đơn (track)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_05b" name="UC-AI-05b: Tool: Tính cước tự động (calc)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_05c" name="UC-AI-05c: Tool: Tra hàng cấm gửi (policy)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_05d" name="UC-AI-05d: Tool: Chính sách bồi thường 100%">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_05e" name="UC-AI-05e: Tool: Tìm bưu cục gần nhất (geo)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_06" name="UC-AI-06: Truy xuất tri thức Hybrid RAG">
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_06_uc_ai_06a" addition="uc_ai_06a"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_06_uc_ai_05a" addition="uc_ai_05a"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_06_uc_ai_05b" addition="uc_ai_05b"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_06_uc_ai_05c" addition="uc_ai_05c"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_06_uc_ai_05d" addition="uc_ai_05d"/>
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_06_uc_ai_05e" addition="uc_ai_05e"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_06a" name="UC-AI-06a: Fallback mô hình LLM (Gemini/GPT)">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_07" name="UC-AI-07: Phản hồi dạng dòng SSE Streaming">
        <include xmi:type="uml:Include" xmi:id="inc_uc_ai_07_uc_ai_07a" addition="uc_ai_07a"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ai_07a" name="UC-AI-07a: Cách ly phiên an toàn (Session)">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_admin" name="Phân Hệ 6: Quản Trị Hệ Thống, RBAC &amp; Cấu Hình (masterdata • auth-service)">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_01" name="UC-ADM-01: Quản lý tài khoản toàn hệ thống">
        <include xmi:type="uml:Include" xmi:id="inc_uc_adm_01_uc_adm_02" addition="uc_adm_02"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_02" name="UC-ADM-02: Phân công nhân sự &amp; Tuyến">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_03" name="UC-ADM-03: Quản lý phân quyền RBAC Matrix">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_04" name="UC-ADM-04: Phân quyền mobile override">
        <extend xmi:type="uml:Extend" xmi:id="ext_uc_adm_04_uc_adm_03" extendedCase="uc_adm_03"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_05" name="UC-ADM-05: Quản lý danh mục Hub 4 cấp">
        <include xmi:type="uml:Include" xmi:id="inc_uc_adm_05_uc_adm_06" addition="uc_adm_06"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_06" name="UC-ADM-06: Quản lý khu vực / Zone địa lý">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_07" name="UC-ADM-07: Danh mục lý do giao NDR">
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_adm_08" name="UC-ADM-08: Cấu hình tham số hệ thống">
