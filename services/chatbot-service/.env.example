PORT=3013
NODE_ENV=development

# =========================================================================
# MULTI-AGENT HETEROGENEOUS ARCHITECTURE (BIG FOUR MODEL PROVIDERS)
# =========================================================================

# 1. Supervisor Agent (Google AI Studio - Free Tier)
# Đăng ký & lấy key tại: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Knowledge Agent & 3. Operation Agent (Groq Cloud LPU - Miễn phí tại console.groq.com)
GROQ_API_KEY=
GROQ_KNOWLEDGE_MODEL=qwen/qwen3.8-27b
GROQ_OPERATION_MODEL=openai/gpt-oss-120b

# 4. Validation Agent / Safety Gatekeeper
# CÁCH 1 (KHUYÊN DÙNG NHẤT): Dùng trực tiếp Groq Safeguard (Dùng ngay GROQ_API_KEY trên, KHÔNG CẦN đăng ký thêm, KHÔNG CẦN OTP số điện thoại)
VALIDATION_PROVIDER=groq
VALIDATION_MODEL=openai/gpt-oss-safeguard-20b

# CÁCH 2: Dùng OpenRouter (Đăng ký tài khoản bằng Google, KHÔNG CẦN số điện thoại, hỗ trợ Llama 3.3 70B & Nemotron)
# OPENROUTER_API_KEY=
# VALIDATION_PROVIDER=openrouter
# VALIDATION_MODEL=meta-llama/llama-3.3-70b-instruct:free

# CÁCH 3: Dùng NVIDIA NIM (Nếu bạn có số điện thoại quốc tế nhận được OTP tại build.nvidia.com)
# NVIDIA_API_KEY=
# VALIDATION_PROVIDER=nvidia
# VALIDATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenAI Config (Dự phòng tùy chọn)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# Upstream Services
TRACKING_SERVICE_URL=http://localhost:3008
PRICING_SERVICE_URL=http://localhost:3012

# Knowledge Base Directory Path (relative to service root or absolute)
KNOWLEDGE_BASE_DIR=../../docs/knowledge-base
VECTOR_INDEX_FILE=../../docs/knowledge-base/vector-index.json
