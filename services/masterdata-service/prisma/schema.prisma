generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Hub {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  level            Int      @default(2) // 0: HQ, 1: Regional Hub, 2: Provincial Hub, 3: Ward Hub
  parentCode       String?
  zoneCode         String?
  address          String?
  district         String?
  ward             String?
  coverageRadiusKm Float?
  boundaryPolygon  Json?    // Array of [latitude, longitude] boundary points
  latitude         Float?
  longitude        Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([parentCode])
  @@index([level])
  @@map("hubs")
}

model Zone {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  parentCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("zones")
}

model NdrReason {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ndr_reasons")
}

model Config {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  scope       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("configs")
}

model MerchantProfile {
  id                   String   @id @default(cuid())
  username             String   @unique
  citizenId            String   @unique
  regionCode           String
  regionLabel          String
  defaultHubCode       String?
  defaultHubName       String?
  defaultSenderAddress String?
  latitude             Float?
  longitude            Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([regionCode])
  @@index([defaultHubCode])
  @@map("merchant_profiles")
}

model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  fullName       String
  phone          String?  @unique
  email          String?
  defaultAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([phone])
  @@map("customer_profiles")
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorUsername String?
  action        String
  targetType    String
  targetId      String?
  before        Json?
  after         Json?
  requestId     String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorUsername, createdAt])
  @@map("admin_audit_logs")
}

model OutboxEvent {
  id           String       @id @default(cuid())
  eventId      String       @unique
  eventType    String
  routingKey   String
  aggregateType String
  aggregateId  String?
  payload      Json
  status       OutboxStatus @default(PENDING)
  retryCount   Int          @default(0)
  occurredAt   DateTime
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, occurredAt])
  @@map("outbox_events")
}

model CourierAreaAssignment {
  id              String   @id @default(cuid())
  courierId       String
  hubCode         String
  province        String
  district        String
  ward            String
  zoneName        String?
  colorHex        String?
  boundaryPolygon Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([courierId, province, district, ward])
  @@index([hubCode])
  @@map("courier_area_assignments")
}

