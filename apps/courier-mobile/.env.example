# Courier Mobile Environment Configuration
# Deployed Cloudflare Gateway Base URL (khong can chay backend local)
EXPO_PUBLIC_GATEWAY_BASE_URL=https://ops.nexus-ex.site

# Fallback URLs
EXPO_PUBLIC_GATEWAY_FALLBACK_BASE_URLS=https://customer.nexus-ex.site,http://localhost:3000

# API Request timeout in milliseconds
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000

# Default Courier ID for test
EXPO_PUBLIC_COURIER_ID=30000001
EXPO_PUBLIC_ALLOW_ALL_COURIER_MOBILE_PERMISSIONS_FOR_TESTING=false

