{
  "name": "courier-mobile",
  "version": "1.0.5",
  "description": "Scaffold toi thieu cho app shipper/courier trong monorepo `NEXUS-logistics`.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node ./scripts/start-with-gateway.js",
    "start:raw": "expo start",
    "test:web": "node ./scripts/start-courier-test.js",
    "test:web:open": "node ./scripts/start-courier-test.js --open",
    "test:maestro": "maestro test maestro/courier-mobile-smoke.yaml",
    "test:qr": "node ./scripts/start-courier-test.js --qr --lan",
    "test:tunnel": "node ./scripts/start-courier-test.js --tunnel",
    "build:web": "expo export --platform web",
    "sync:ip": "node ../../scripts/sync-mobile-ip.js",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:apk:prod": "eas build --platform android --profile production-apk --non-interactive",
    "android": "node ./scripts/start-with-gateway.js --android",
    "ios": "node ./scripts/start-with-gateway.js --ios",
    "web": "node ./scripts/start-with-gateway.js --web",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
