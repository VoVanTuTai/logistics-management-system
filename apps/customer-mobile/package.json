{
  "name": "customer-mobile",
  "version": "1.0.0",
  "description": "Customer Mobile App cho Khach hang Ca nhan trong monorepo NEXUS Express System.",
  "main": "index.js",
  "scripts": {
    "start": "node ./scripts/start-with-gateway.js",
    "start:raw": "expo start",
    "android": "node ./scripts/start-with-gateway.js --android",
    "ios": "node ./scripts/start-with-gateway.js --ios",
    "web": "node ./scripts/start-with-gateway.js --web",
    "test:qr": "node ./scripts/start-with-gateway.js --lan",
    "build:web": "expo export --platform web",
    "sync:ip": "node ../../scripts/sync-mobile-ip.js",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:apk:prod": "eas build --platform android --profile production-apk --non-interactive",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@types/qrcode-generator": "^0.0.16",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-location": "~58.0.22",
    "expo-print": "~58.0.9",
    "expo-sharing": "~58.0.23",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~58.0.26",
    "eas-cli": "^27.11.0",
    "react-refresh": "^0.18.0",
    "typescript": "~6.0.3"
  }
}
