# Customer Mobile Environment Configuration
# Production VPS Gateway Base URL (port 13000 mapped on VPS or via Nginx domain proxy)
EXPO_PUBLIC_GATEWAY_BASE_URL=https://customer.nexus-ex.site

# Fallback URLs if the primary domain is unreachable (separated by commas)
EXPO_PUBLIC_GATEWAY_FALLBACK_BASE_URLS=https://ops.nexus-ex.site,http://103.82.20.51:13000,http://localhost:13000,http://localhost:3000

# API Request timeout in milliseconds
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
